{
  "ruleset_id": 14695153,
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "refs/heads/main"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": false,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "SDLC Gate",
            "integration_id": 15368
          }
        ]
      }
    }
  ],
  "production_environment_unchanged": true,
  "production_required_reviewers_preserved": true,
  "production_admin_bypass": false,
  "user_authorization": "owner-merge-and-single-maintainer-authorization.json",
  "rollback": "Restore the prior required approving review count and review flags if another maintainer joins; preserve CI and production protection"
}
